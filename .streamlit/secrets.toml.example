# ==============================================================================
# AGENT_MIND / Neuroplexa AI — Example Secrets Configuration
#
# INSTRUCTIONS:
# 1. Copy this file to .streamlit/secrets.toml:
#    cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Fill in your API keys and credentials below.
# 3. NEVER commit your actual secrets.toml file to git!
# ==============================================================================

# --- Primary Large Language Models ---
# Google Gemini (Primary generation, tool routing, file analysis)
GOOGLE_API_KEY = "your-google-gemini-api-key"

# Groq (Ultra-fast candidate model and fallback router)
GROQ_API_KEY = "your-groq-api-key"

# Mistral AI (Blind evaluation judge model)
MISTRAL_API_KEY = "your-mistral-api-key"

# DeepSeek (Candidate model for deepseek-flash / deepseek-chat)
DEEPSEEK_API_KEY = "your-deepseek-api-key"

# Kimi / Moonshot AI (Candidate model for kimi-k3 / moonshot-v1)
KIMI_API_KEY = "your-kimi-api-key"


# --- Image Generation & Web Search ---
# Pollinations AI (Image generation token)
POLLINATIONS_TOKEN = "your-pollinations-ai-token"

# Tavily (Advanced web search and grounding)
TAVILY_API_KEY = "your-tavily-search-api-key"

# --- Long-Term Vector Memory & Threat Audit (Qdrant Cloud) ---
QDRANT_URL = "https://your-cluster-id.region.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your-qdrant-cloud-api-key"

# --- Security, Authentication & Access Control ---
# Server-side high-entropy pepper for scrypt key derivation (protects against rainbow tables)
AUTH_PEPPER = "change-this-to-a-random-high-entropy-secret-string"

# Admin Dashboard Access (true to enable global audit visibility across all sessions)
ADMIN = false
